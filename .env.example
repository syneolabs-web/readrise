# Copy to `.env` and fill in. Never commit the filled version — `.gitignore`
# blocks `.env` and `.env.local` on purpose.
#
# Prisma's CLI reads `.env` only; Next.js reads both `.env` and `.env.local`.
# Keeping everything in `.env` avoids the "works in the app, fails in the CLI"
# class of confusion.

# ── Database ────────────────────────────────────────────────────────────────
# Supabase → Connect → ORMs → Prisma. You need BOTH URLs:
#
#   DATABASE_URL  Transaction pooler (port 6543). Used at runtime. Serverless
#                 functions open a connection per invocation, so a direct
#                 connection would exhaust Postgres' limit under load.
#                 `pgbouncer=true` tells Prisma to skip prepared statements,
#                 which the transaction pooler cannot support.
#
#                 DO NOT set connection_limit=1. That value is widely repeated
#                 for serverless Prisma, and it breaks this app: pages run
#                 several queries concurrently through Promise.all (the
#                 dashboard alone runs three), and with a pool of one those
#                 queries wait on each other until they time out. The symptom
#                 is a 500 on every logged-in page with Prisma error P2024,
#                 "Timed out fetching a new connection from the connection
#                 pool" — which reads like a database outage rather than a
#                 setting. pgbouncer multiplexes behind us, so a small pool
#                 per instance is both safe and necessary.
#
#   DIRECT_URL    Direct connection (port 5432). Used by `prisma db push` and
#                 `migrate` only. Schema changes need a real session, which the
#                 transaction pooler cannot give them.
#
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Auth ────────────────────────────────────────────────────────────────────
# Signs the session JWT. Anyone holding this can forge a session for any user,
# so production MUST NOT reuse the development value. Generate a fresh one:
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET="<64+ random characters — generate a NEW one for production>"

# ── Supabase (storage + realtime) ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only. Bypasses RLS, so it must NEVER be prefixed NEXT_PUBLIC_ and
# never reach the browser bundle. Dashboard → Project Settings → API keys.
# Without it, uploads fall back to local disk — which does not survive on
# Vercel, where the filesystem is ephemeral. Required in production.
SUPABASE_SECRET_KEY="sb_secret_..."

# ── Local dev only ──────────────────────────────────────────────────────────
# Where PDFs are written when SUPABASE_SECRET_KEY is absent. Ignored in
# production. Deliberately outside public/ — files are served only through
# /api/documents/[id]/file, which checks circle membership first.
STORAGE_DIR="./storage"
